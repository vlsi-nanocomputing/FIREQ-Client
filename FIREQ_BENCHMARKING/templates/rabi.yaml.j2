# Rabi experiment

preprocess:
  drive_modulation_frequency: {{ drive_modulation_frequency }}
  readout_modulation_frequency: {{ readout_modulation_frequency }}
  readout_duration: {{ readout_duration }}
  gain_r: {{ gain_r }}
  tof: {{ tof }}
  drive_duration: {{ drive_duration }}

variables:
  gain_sweep:
    start: {{ gain_sweep_start }}
    stop: {{ gain_sweep_stop }}
    num: {{ gain_sweep_num }}
    mode: {{ gain_sweep_mode | default("lin") }}

sys_config:
  $shots: {{ shots | default(1000) }}

  /axisGeneratorIP_{{axis_generator_index | default(0)}}:
    $dfrequency: "%drive_modulation_frequency"
    $rfrequency: "%readout_modulation_frequency"
    $rphase: 0.0
    $rchannel: {{ readout_channel | default(1) }}
    $dchannel: {{ drive_channel | default(1) }}

    pulse:
      - _name: rect_d
        _readout: false
        _envelope: _RECTANGULAR
        _dac_target: {{ drive_dac_target | default(1) }}
        $duration: "%drive_duration"
        $gain: "#gain_sweep"

      - _name: rect_r
        _readout: true
        _envelope: _RECTANGULAR
        _dac_target: {{ readout_dac_target | default(1) }}
        $duration: "%readout_duration"
        $gain: "%gain_r"

    $drive_order:
      - rect_d

  /axisAcquisitionIP_{{axis_acquisition_index | default(0)}}:
    $duration: "%readout_duration"
    $output_type: accumulated
    $rfrequency: "%readout_modulation_frequency"
    $rphase: 0.0
    $rchannel: {{ readout_channel | default(1) }}
    $tof: "%tof"

  /axisTriggerGenerator_{{axis_trigger_index | default(0)}}:
    $experiment_duration: {{ experiment_duration | default(70000.0) }}

    delay:
      - _name: drive_delay_0
        _ttype: drive
        _channel_mask: {{ drive_channel_mask | default(1) }}
        _index: 1
        $delay: {{ drive_delay | default(100) }}

      - _name: readout_delay_0
        _ttype: readout
        _channel_mask: {{ readout_channel_mask | default(1) }}
        _index: 2
        $delay: {{ readout_delay | default(200) }}